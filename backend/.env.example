# ==============================================================================
# Circular E-Waste Recovery Platform (Application 1: Collection & Recovery)
# Environment Variables Configuration
# Copy this file to .env or backend/.env for local development.
# In production on Vercel, configure these in Project Settings -> Environment Variables.
# NEVER place real secrets or credentials in source code.
# ==============================================================================

# Production mode flag: true for Vercel production deployment, false for local development
IS_PRODUCTION=false

# Application Secret Keys for CSRF protection and session signing
# Required in Vercel environment variables to maintain stable sessions across serverless containers
SECRET_KEY=
CIRCULAR_SECRET_KEY=

# Shared Supabase PostgreSQL Database (Collection Schema)
# In production on Vercel, use the Supabase Transaction Pooler (port 6543):
# Format: postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# For local development: sqlite:///instance/circular.sqlite3
DATABASE_URL=sqlite:///instance/circular.sqlite3

# Supabase Storage Configuration (Shared private bucket: ewaste-files)
# Organization: collection/devices/{device_id}/images/ and collection/devices/{device_id}/documents/
STORAGE_PROVIDER=local
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=ewaste-files

# Inbound API Authentication Key
# Used by partner application to authenticate callbacks to POST /api/v1/assessment-results
# Matches partner's COLLECTION_API_KEY
CIRCULAR_API_KEY=

# Outbound Partner Integration (Refurbishment Intelligence Service)
# Base URL of partner's deployed Vercel application
PARTNER_API_URL=https://partner-refurbishment-intelligence.vercel.app
# API key issued by partner for authenticating outbound calls (matches partner's PARTNER_INBOUND_API_KEY)
PARTNER_API_KEY=

# Demo Data Seeding Policy (false for production, true for development)
SEED_DEMO_DATA=false
