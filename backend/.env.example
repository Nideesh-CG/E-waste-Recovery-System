# ==============================================================================
# Circular E-Waste Recovery & Refurbishment Platform - Environment Configuration
# Copy this file to .env or backend/.env for local development
# Do NOT commit real secrets to source control.
# ==============================================================================

# Production mode flag (set to true in Render / hosted production environments)
IS_PRODUCTION=false

# Primary Flask Secret Key (Required in production)
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
CIRCULAR_SECRET_KEY=

# Server Port (Render sets $PORT automatically, default: 5000)
FLASK_PORT=5000

# Database Connection URL
# Local Development (SQLite default):
DATABASE_URL=sqlite:///instance/circular.sqlite3
# Production (Render PostgreSQL connection string - automatically normalized from postgres:// or postgresql://):
# DATABASE_URL=postgresql://user:password@dpg-xxxxxx.render.com/circular_ewaste

# File Storage Configuration (Pure local / Render persistent disk filesystem)
# Local development default: instance/uploads
# Render persistent disk mount: /var/data/uploads
UPLOAD_STORAGE_PATH=instance/uploads

# Maximum upload request size (in bytes, default: 11534336 = ~11MB; individual files max 5MB)
MAX_CONTENT_LENGTH=11534336

# Inbound API Authentication Key (Required in production for partner assessment callbacks)
CIRCULAR_API_KEY=

# Outbound Partner Integration (Refurbishment Intelligence Service)
# When configured, device transfers will be dispatched to this external service
PARTNER_API_URL=
PARTNER_API_KEY=

# Demo Data Seeding Policy (true for fresh local dev demonstration, false for production)
SEED_DEMO_DATA=true
